#!/bin/sh
# pre-push — 用 POSIX sh（Termux 有 /bin/sh，没有 /usr/bin/env 和 /bin/bash），
# 实际检查交给 bash 脚本。两边平台都能跑。
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "== pre-push: 脱敏门（公开前的硬阻断）=="
# 为什么放在 ci 之前：ci 证明代码是对的，sanitize 证明它【可以公开】。后者一旦
# 漏掉就不可逆 —— 内网地址、公网入口主机名、私钥路径一旦推上去就等于公开。
# 豁免走 scripts/sanitize.allow（gitignored），所以本机可以用它放行本机专属的行。
# ⚠ 平时 push【不】被脱敏拦住：命中的都是作者自己的网络信息，在私有仓库里它们
#   本来就该在（代码里的 PFAN_HOST 默认值删了就坏）。条数每次规则一改就变，所以
#   这里【不】写死 —— 要看多少条跑 `bash scripts/sanitize.sh`。一旦漏推出去就不可逆，所以
#   阻断点放在「人明确表示要发布」的那一刻：
#       PFAN_PUBLISH=1 git push     ← 远端将公开时用这个
#   平时用 PFAN_SKIP_SANITIZE=1 显式跳过（脚本会把它记成"你决定了"，不是静默放过）。
# ⚠ 必须把非零退出码接住：pre-push 顶部有 set -e，而 sanitize.sh 发现命中就返回非0 ——
#   不接住的话，整个 hook 会在这一行静默死掉，git 只报 "failed to push some refs"，
#   看不到任何原因（2026-10-10 实测踩到）。接法就是下面的 `|| _san_rc=$?`：
#   命令的退出码被赋进变量，set -e 便不触发。
#   （这里原先连着跑了两次 sanitize.sh：头一遍 `|| true` 把结果整个丢掉，第二遍才取码。
#    895d9ad 的遗留。同一份检查跑两遍只是白费一次扫描；真正的问题不是"跑两遍"，
#    而是第一遍的结果从来没人看 —— 删掉的是它，留下的是接码的那一遍。）
_san_rc=0
bash scripts/sanitize.sh > /dev/null 2>&1 || _san_rc=$?
if [ "${PFAN_PUBLISH:-0}" = 1 ]; then
  if [ "$_san_rc" -ne 0 ]; then
    echo "pre-push 拒绝：PFAN_PUBLISH=1 表示远端将公开，但脱敏检查未通过。"
    echo "  bash scripts/sanitize.sh 看逐条清单。三条路：改掉 / 写进 scripts/sanitize.allow /"
    echo "  确认不敏感后写进 allow 并说明理由。绝不要用 PFAN_SKIP_SANITIZE 绕过发布门。"
    exit 1
  fi
  echo "  发布门通过：脱敏全绿"
elif [ "${PFAN_SKIP_SANITIZE:-0}" = 1 ]; then
  echo "  (PFAN_SKIP_SANITIZE=1 —— 本次推送显式跳过脱敏)"
else
  echo "  脱敏：有命中但不阻断（私有仓库可接受）。公开前请用 PFAN_PUBLISH=1 git push。"
fi

echo "== pre-push: bash scripts/ci.sh =="
bash scripts/ci.sh || { echo "pre-push 拒绝：ci 未通过"; exit 1; }

# ⚠ 必须把 ssh 的退出码显式接住：`set -e` 下，命令替换赋值的退出码就是 ssh 的
# 退出码，机器不可达时整支钩子会在这里直接中止，下面那几行"打印原因 + 接受
# PFAN_SKIP_SMOKE"就成了死代码（实测：rc=255、原因一个字不打印、flag 完全无效）。
# PFAN_HOST 可覆盖（默认 192.168.1.10）。目标机只能经 Cloudflare SSH 隧道到达时，
# 设成 ssh config 里的别名即可，例如 PFAN_HOST=pfan-tunnel（该别名自带 ProxyCommand）。
PFAN_HOST="${PFAN_HOST:-192.168.1.10}"
SSH_OPTS="-i $HOME/.ssh/pfan_deploy_key -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10"
[ "$PFAN_HOST" = "192.168.1.10" ] || SSH_OPTS=""   # 别名由 ssh config 自己提供 ProxyCommand
probe_rc=0
# shellcheck disable=SC2086
probe_err=$(ssh $SSH_OPTS pfan@"$PFAN_HOST" true 2>&1 >/dev/null) || probe_rc=$?
if [ "$probe_rc" -eq 0 ]; then
  echo "== pre-push: bash scripts/smoke.sh（机器可达）=="
  PFAN_HOST="$PFAN_HOST" bash scripts/smoke.sh || { echo "pre-push 拒绝：冒烟未通过"; exit 1; }
else
  # 不可跳过的原因必须可见：机器宕、密钥缺失、没有 ssh 三者表现不同（复审 I5）
  echo "pre-push: smoke 未运行 —— 原因如下（ci 仍强制）："
  echo "$probe_err" | sed 's/^/    /'
  echo "    如需在无该密钥的机器上有意跳过，显式设置 PFAN_SKIP_SMOKE=1"
  # ⚠ 这里【必须】用 if，不能用 `[ ... ] && echo`：
  # 在 set -e 下，条件为假的 `&&` 链返回 1，会让整个钩子以 rc=1 退出 ——
  # 表现是"机器不可达时 push 无理由被拒"，日志正好停在上一行（2026-10-08 实测）。
  if [ "${PFAN_SKIP_SMOKE:-0}" = 1 ]; then
    echo "    (PFAN_SKIP_SMOKE=1 已设置)"
  fi
fi
