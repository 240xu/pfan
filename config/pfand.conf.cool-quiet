# 预设 A：安静优先（Cool & Quiet）
# 依据 85h 实测（p50=50 / p90=58 / p99=67 / max=73）：99% 的时间都在 67°C 以下，
# 现状曲线在这个区间却已经爬到 40~50% —— 骨架整体右移，把低中负载压回低档。
# 成熟温控的做法：日常工作区尽量慢，高档位留给真正的热负载。
IDLE=54
L0=25
T1=62
L1=28
T2=68
L2=34
T3=73
L3=44
T4=78
L4=56
T5=82
L5=66
# 应急：起点抬到 85，但滞回保持 80 起锁（进入易、退出难）
EMERG=85
E=100
EMERG_REL=80
CAP=70
TRIM=5
GAIN=1
# 防抖收紧：HYST 4°C + DWELL 45s，避免温度在阈值附近来回切档（噪音比温度更烦）
#
# ⚠ 上面两条在 2026-10-09 之前都是假的，而它们是本文件存在的理由：
#   core/pfand 的 floor_of/center_of 原先硬编码 {25,30,40,50,60,70} 字面梯子，本文件的
#   25/28/34/44/56/66 整体落进 `*)` 返回 $EMERG，于是 HYST 恒不生效（降档门
#   `T <= EMERG-HYST` 恒真）、trim 被永久钉在 -TRIM。已改为按实际 L0..L5 推导，
#   tests/python/test_curve_presets.py 现在逐温度点核对实际交付档位。
#   改动 floor_of/center_of 或本文件的档位后先跑那个测试 —— 它验交付值，不验声明值。
HYST=4
DWELL=45
DEAD=2
IV=10
