# ⑭ /var/log/pfand.log 轮转
# 必须用 copytruncate：pfand 用 `>>"$LOG"` 追加且【没有信号处理】，
# 普通的 create/rename 会让它的 fd 继续指向被移走的文件，之后的日志全部丢失。
# su 必填：/var/log 是 775 root:syslog（组可写），logrotate 遇到非 root 组可写的
# 父目录会直接拒转（"insecure permissions"）。缺这行要等部署时的 -d 自检才炸。
su root syslog

/var/log/pfand.log {
	daily
	rotate 7
	maxsize 10M
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
	sharedscripts
}

# pfanel.log 由 guard() / set_curve 兜底分支写入（罕见，涨得慢，但没人轮转就永远涨）。
# 与 pfand 同因同治：pfanel 也是 `>>` 追加、没有信号处理 → 必须 copytruncate。
# su 用顶部的全局 `su root syslog`（logrotate 全局指令覆盖本文件所有段，
# 本仓库 deploy.sh 有 logrotate -d 自检）。
/var/log/pfanel.log {
	daily
	rotate 7
	maxsize 10M
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
	sharedscripts
}
