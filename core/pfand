#!/bin/bash
# pfand - 松下 CFQV8 风扇控制：分级骨架 + 细粒度微调
#
# 为什么需要 s0i3：s0i3(EC 0x79=0x02) 下固件退出热保护，EC 完全跟随 _FSL。
# 其它模式下 EC 把风扇顶到 58~73%，本守护形同虚设。
#
# 为什么分级+微调而不是纯比例：
#   实测本机 25%→70% 全核负载只差 5°C，扇热极强，比例增益标定不可靠；
#   分级骨架已在 v2 验证稳定（4.5 分钟仅 3 次调档）。
#   但固件支持 0~120 任意整数（fine_grain_control=1，实测 37/62/68 精确跟随），
#   所以在骨架上叠加 ±TRIM 的连续微调，消掉台阶感。
#
# 微调的关键设计：trim 只快升慢降（每轮向 0 泄 1），像"增压后泄压"，
#   天然带惯性，不会因温度小幅抖动而反复加加减减。
#
IDLE=50; L0=25
T1=56; L1=30
T2=62; L2=40
T3=67; L3=50
T4=72; L4=60
T5=79; L5=70        # 上限
EMERG=80; E=100
EMERG_REL=75
CAP=70              # 微调后硬上限
TRIM=6              # 微调幅度 ±
GAIN=1              # 每偏离 1°C 的微调量
HYST=3              # 降档死区 °C
DWELL=30            # 调档最小间隔 s
DEAD=2              # 输出死区：与当前值差 <DEAD 不写
IV=10

LOCK="${PFAN_LOCK:-/run/pfanel.lock}"
LOG="${PFAN_LOG:-/var/log/pfand.log}"
log(){ echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$LOG"; }

# 平台配置：路径一律来自 platform.conf，本文件不再硬编码 ACPI/热区路径。
# 缺失即 fail-safe —— 绝不带错误路径空转（会把风扇交给一个读不到温度的控制律）。
_plat_sh="${PFAN_PLATFORM_SH:-/usr/local/lib/pfan/platform.sh}"
[ -f "$_plat_sh" ] || _plat_sh="$(dirname "$0")/platform.sh"
# 关键：解析出路径后必须真的 source 它，否则 pfan_plat 未定义，
# 下面所有 $(pfan_plat ...) 都会静默变成空串（2026-10-06 实测导致风扇停转）。
if [ -f "$_plat_sh" ]; then . "$_plat_sh"; fi
CAND="${PFAN_CANDIDATES:-$(dirname "$0")/../platform/fan-candidates.txt}"
[ -f "$CAND" ] || CAND="${PFAN_CANDIDATES:-/etc/pfan/fan-candidates.txt}"
# 测试接缝，语义同 pfan
DEV="${PFAN_DEV:-}" ; [ -n "$DEV" ] || DEV=$(pfan_plat DEV 2>/dev/null) || DEV=/dev/pfanctl
# 这三个接缝的【缺省值必须等于生产值】—— tests/shell/test_pfand_loop.sh 的 T0 会断言。
# 用它们是为了让守护能在没有内核模块/没有 root 的开发机上被真正跑起来。
DMESG="${PFAN_DMESG:-dmesg}"
CONF="${PFAN_CONF:-/etc/pfand.conf}"
CURVE_FILE="${PFAN_CURVE_FILE:-/var/lib/pfanel/curve.state}"
# ⑬ 应急锁定必须持久化：emerg 是【滞回】状态（进易出难），只存内存的话，
# 守护重启后温度若落在 [EMERG_REL, EMERG) 区间，want_for 会直接给 L5 —— 等于提前解除应急。
EMERG_FILE="${PFAN_EMERG_FILE:-/var/lib/pfanel/emerg.state}"
# 设备判定：生产要求字符设备（模块没加载就该 fail-safe）；
# 显式设置了 PFAN_DEV 则只查存在性 —— 假设备是普通文件。
dev_ok(){ if [ -n "${PFAN_DEV:-}" ]; then [ -e "$1" ]; else [ -c "$1" ]; fi; }
# I6：DEV 存在却【不是字符设备】= 文档化的事故形态（2026-10-06 实例：
# rmmod 删掉节点后，一条 `echo … > /dev/pfanctl` 把它重建成普通文件，
# 此后所有读写被静默丢弃约 2 分钟，风扇停在旧档）。
# 这种文件上 `echo > "$DEV"` 会"成功"却永远到不了硬件 —— 所以两个 fail-safe
# 分支都必须先认出它：点名危害 + 给恢复命令，且绝不声称尝试/完成过写入。
# PFAN_DEV 是测试接缝（假设备本来就是普通文件）：它只在 dev_ok 的【正常路径】里
# 豁免 -c；fail-safe 写入不豁免 —— 豁免就等于允许凭空造文件（I2）。
# （I2）原先那个"存在且不是字符设备"的守卫已删除：它在【节点缺失】时为假，
# 于是 fail-safe 自己把普通文件造了出来。两个 fail-safe 分支现在统一先过
# dev_refuse_write，判据是 [ -c "$DEV" ]，缺节点与普通文件都一样拒写。
log_dev_hazard(){
    log "CRITICAL: $DEV 存在但不是字符设备（普通文件）—— rmmod 后被重建成普通文件，风扇读写全部被静默丢弃、档位停在旧值。恢复: rm -f $DEV && insmod /opt/pfanctl/pfanctl.ko（或 systemctl restart pfanctl）"
}
# I2：写入前提【只有一个】—— 字符设备已经存在（[ -c "$DEV" ]）。
#   · 节点存在却是普通文件      -> 写进去也到不了硬件（I6，上面那个守卫）；
#   · 节点缺失（rmmod 后的前提）-> `echo … > "$DEV"` 会把普通文件【凭空创建】出来，
#     此后 devtmpfs/insmod 因 EEXIST 复建不了节点，而日志还记下"尝试满速/已写满速"
#     —— 正是 I6/I2 禁止的那种到不了硬件的假成功。缺节点时守卫为假，等于守卫
#     自己制造了它要检测的危害，所以两个 fail-safe 分支都必须先过这一关。
#   用法: 写之前先 `dev_refuse_write || exit 1`（一个字节都不许写）。
dev_refuse_write(){
    if [ -n "${DEV:-}" ] && [ -e "$DEV" ]; then
        log_dev_hazard                      # 存在但不是字符设备（I6）
    elif [ -n "${DEV:-}" ]; then
        log "CRITICAL: $DEV 不是字符设备（节点缺失，多为 rmmod 之后）—— 在这里 echo 会把普通文件凭空创建出来，此后 devtmpfs/insmod 因 EEXIST 复建不了节点，风扇档位全部写不到硬件。恢复: insmod /opt/pfanctl/pfanctl.ko（或 systemctl restart pfanctl）；不要手工创建 $DEV"
    else
        log "DEV 路径为空 -> fail-safe 无法写入任何设备"
    fi
    return 1
}
F=$(pfan_plat FAN_DEVICE 2>/dev/null) || F=""
Z=$(pfan_plat THERMAL_ZONE 2>/dev/null) || Z=""
# EC 根是【另一条】路径：EC88 写 EC 寄存器必须挂在 EC 根下，不是挂在风扇设备下。
# 旧代码用 $F.EC88 拼出 ...TFN1.EC88，实测 get_handle 恒返回 AE_NOT_FOUND(5)。
EC=$(pfan_plat EC_ROOT 2>/dev/null) || EC=""
# PFAN_PROBE=1: 只解析并打印平台路径就退出（测试用；生产绝不设置）。
# 放在 fail-safe 之前，测试才能观察到"解析为空"这种失败形态。
if [ "${PFAN_PROBE:-0}" = 1 ]; then
  printf 'FAN_DEVICE=%s\nTHERMAL_ZONE=%s\nEC_ROOT=%s\nDEV=%s\nCANDIDATES=%s\nLOADER=%s\n' \
    "$F" "$Z" "$EC" "$DEV" "$CAND" "$_plat_sh"
  exit 0
fi
if ! command -v pfan_plat >/dev/null 2>&1 || [ -z "$F" ] || [ -z "$Z" ] || [ -z "$EC" ]; then
  # ⑥ /dev/pfanctl 是单槽设备，必须与 pfanel/pfan 共用同一把锁
  exec 9>"$LOCK" 2>/dev/null
  log "平台配置不可用(F='$F' Z='$Z' EC='$EC', 加载器 '$_plat_sh') -> fail-safe 满速 100%（先跑 pfan detect）"
  # I6：DEV 是普通文件时，下面的候选写入只会把字节写进一个假节点，
  # 然后日志声称"已写满速"—— 到不了硬件的假话。先认出危害，一行都不写。
  # I2：节点【缺失】时同一个 echo 会把普通文件凭空创建出来（rmmod 后的前提），
  # 所以这里的判定必须是"是不是字符设备"，而不是"文件存在且不是普通文件"。
  if [ -z "$DEV" ] || [ ! -c "$DEV" ]; then
    dev_refuse_write
    exit 1
  fi
  # F 未知时对候选清单里的每个风扇设备都写 100%：哪个能解析哪个生效
  _wrote=0
  if [ -r "$CAND" ]; then
    while read -r _ec _fan; do
      [ -n "$_fan" ] || continue
      flock -x 9 2>/dev/null && { echo "$_fan._FSL 1 100" > "$DEV" 2>/dev/null && _wrote=1; flock -u 9 2>/dev/null; }
    done < <(grep -vE '^#|^$' "$CAND")
  else
    log "候选清单不可读: '$CAND' —— fail-safe 无法写入任何候选"
  fi
  [ "$_wrote" = 1 ] && log "fail-safe 已写满速（候选清单）" || log "fail-safe 写入失败（DEV='$DEV' 不可用？）"
  # 必须非零退出：Restart=on-failure 才会每 15s 重试，
  # 等 platform.conf 修好后自动接管；exit 0 会让守护就此死掉、无人再写 100%。
  exit 1
fi
# ⑥ /dev/pfanctl 是单槽设备，必须与 pfanel/pfan 共用同一把锁，
#    否则读到别人刚写的 RESULT（2026-10-05 审计）。
exec 9>"$LOCK"
if [ -z "$DEV" ] || ! dev_ok "$DEV"; then
  # I6：-c 判定失败的根因若是"节点被重建成普通文件"，echo > $DEV 这一写
  # 只会成功地写进假节点 —— 不许记录"尝试满速"，必须点名危害与恢复命令。
  # I2：根因若是"节点缺失"（rmmod 后的真实前置），同一个 echo 会把普通文件
  # 【凭空创建】出来并留下假的"尝试满速"—— 两个根因都必须一行不写就退出。
  # 进到这里意味着 dev_ok 已失败：DEV 为空 / 节点缺失 / 存在但不是字符设备，
  # 三者都不满足 [ -c "$DEV" ]，直接走统一的危害日志。
  dev_refuse_write
  exit 1
fi
LOG=${PFAN_LOG:-/var/log/pfand.log}

getL(){
    # 必须等「新的 RESULT 行」出现：旧实现第一轮就取 tail -1，
    # 而历史 RESULT 一直留在 dmesg 里 → 永远返回上次的旧值。
    flock -x 9
    local before after d found=""
    # 时间戳判定（不是行数）：dmesg 环形缓冲会淘汰旧行，行数会下降
    # awk -F'[][]' 拆第二段即可拿到时间戳；sed 需要数字紧跟 [，
    # 而 dmesg 在秒数不足 5 位时会补空格（如 "[  862.946343]"），会导致匹配失败
    before=$("$DMESG" 2>/dev/null | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
    echo "$F._FST" > "$DEV" 2>/dev/null
    for _ in $(seq 1 20); do
        sleep 0.12
        after=$("$DMESG" 2>/dev/null | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
        if [ -n "$after" ] && [ -n "$before" ] && \
           awk -v a="$after" -v b="$before" 'BEGIN{exit !(a>b)}'; then
            d=$("$DMESG" 2>/dev/null | grep -oE "RESULT \[[0-9]+,[0-9]+" | tail -1)
            [ -n "$d" ] && found="${d##*,}"
            break
        fi
    done
    flock -u 9
    # 读不到就返回空：调用方据此判断「不确定」，绝不能当成"已经在目标档"
    # （旧实现回退 ${written:-25}，导致启动对齐跳过写入，风扇停在 ensure_s0i3 的 0）
    if [ -n "$found" ]; then echo "$found"; else echo ""; fi
}
setL(){ flock -x 9; echo "$F._FSL 1 $1" > "$DEV" 2>/dev/null; flock -u 9; }
# 载入曲线参数（面板通过改 /etc/pfand.conf 调整；缺失时用脚本内默认值兜底）
[ -r "$CONF" ] && . "$CONF"

# ⑧ 只有 s0i3 模式才该由本守护接管。旧实现无条件 ensure_s0i3()，会把用户选的
#    quiet/cool 静默改成 s0i3（set_curve("auto") 也会 restart pfand 触发）。
CURVE=$(python3 -c "import json;print(json.load(open('$CURVE_FILE'))['curve'])" 2>/dev/null || echo auto)
if [ "$CURVE" != "s0i3" ]; then
    log "当前曲线=$CURVE (非 s0i3)，pfand 不接管，正常退出"
    exit 0
fi

# ③ 配置自校验：/etc/pfand.conf 可被直接编辑（绕过 panel 的 validate_params），
#    非法值会让应急逻辑失效（实测：EMERG=53 但 EMERG_REL=75 → 应急进得去立刻出来）。
#    不校验就把风扇交给一个坏掉的控制律，所以非法就 fail-safe 满速退出。
_cfg_bad=0
for _k in IDLE T1 T2 T3 T4 T5 L0 L1 L2 L3 L4 L5 EMERG E EMERG_REL CAP TRIM GAIN HYST DWELL DEAD IV; do
    eval "_v=\${$_k:-}"
    case "$_v" in
        "" | *[!0-9]*)
            log "配置项 $_k 非法('$_v') -> fail-safe 满速 100% 并退出"
            _cfg_bad=1 ;;
    esac
done
if [ "$_cfg_bad" = "0" ]; then
    # 进入阈值必须高于退出阈值，否则应急形同虚设
    #
    # 应急档 E 还必须【高于】日常硬上限 CAP，相等也不行：
    #   E < CAP -> 最热温度 want_for() 直接返回 E，比日常上限还弱。实测 E=50 CAP=70
    #             被放行，85°C 启动对齐写 _FSL 1 50，日志却记「立即满速 50%」
    #             —— 既是欠冷却（最热时风扇比平时上限还慢），也是谎报。
    #   E = CAP -> 「应急」与日常上限无差别，等于没有应急。
    # 面板那份 validate_params 已于同一条判据同步（server/pfan_core.py:55，E <= CAP）；
    # 两边必须一致：面板接受并持久化、守护却拒绝启动，是这个项目反复出现的形态
    # ——操作员看到面板说 OK，风扇却满速且没有控制环。
    # 出厂两套预设与 example 都是 E=100 CAP=70，严格这条不会误伤任何现役配置。
    if [ "$EMERG_REL" -ge "$EMERG" ] || [ "$T5" -ge "$EMERG" ] || [ "$L5" -gt "$CAP" ] \
       || [ "$E" -le "$CAP" ]; then
        log "配置不自洽(EMERG_REL=$EMERG_REL EMERG=$EMERG T5=$T5 L5=$L5 E=$E CAP=$CAP) -> fail-safe 满速 100% 并退出"
        _cfg_bad=1
    fi
    # 档位下界：L0 不能低于 _FPS 表最低档（25），E/CAP/各级也不能为 0。
    # 上面只查了"是不是数字"和三条关系，漏了下界，而下界正是【停转】：
    #   E=0   -> setL "$E" 在最热温度写 _FSL 1 0（实测，专家审计 C1）
    #   CAP=0 -> apply() 钳到 0，d=|0-written|=0 < DEAD，于是【不写不记日志】，
    #            风扇停在 ensure_s0i3 握手留下的 0 上（实测，C2）
    if [ "$E" -lt 25 ] || [ "$CAP" -lt 25 ] || [ "$L0" -lt 25 ]; then
      log "配置档位下界非法(E=$E CAP=$CAP L0=$L0，三者都须 >= 25 = _FPS 最低档；0=风扇停转) -> fail-safe 满速 100% 并退出"
      _cfg_bad=1
    fi
    for _lv in L1 L2 L3 L4 L5; do
      eval "_v=\${$_lv}"
      if [ "$_v" -lt 25 ]; then
        log "配置 $_lv=$_v 低于 _FPS 最低档 25 -> fail-safe 满速 100% 并退出"
        _cfg_bad=1
      fi
    done
fi
if [ "$_cfg_bad" = "1" ]; then
    flock -x 9; echo "$F._FSL 1 100" > "$DEV" 2>/dev/null; flock -u 9
    # 必须非零退出，与上面平台配置不可用的 fail-safe 同一条规则（见 :123-125）：
    # systemd 写的是 Restart=on-failure / RestartSec=15（systemd/pfand.service:11-12），
    # exit 0 等于让守护就此死掉 —— 实测 E=70 CAP=70 时它写 _FSL 1 100 然后 exit 0，
    # 风扇停在 100% 且 15s 后不再重试，只能等人来改配置。
    #
    # 为什么这条收紧是【严格更好】而不是把"降级运行"变成"死循环"：
    # 本分支之前 E == CAP 是被放行的（守护降级运行），所以没有人在意退出码；
    # 现在 E <= CAP 被拒，一份原本能跑的配置就此变成 dead-loop 形态。
    # 而重试的代价是零：每次启动都会重写同一个 fail-safe 档位（上面那行 echo），
    # 重试只是把同一次写入每 15s 重复一次，配置一改好就自己接管。
    exit 1
fi

ensure_s0i3(){
    # 握手前要有一次 _FSL 写。旧实现写 0，于是每次启动都先把风扇停掉，
    # 直到这次写和随后的 EC 写做完才恢复 -- 实测至少两段 0.3s 的窗口。
    # 改成写【此刻已经在 force 的档位】：握手的形状一个字没改（仍是
    # _FSL 写 + EC88 写），但风扇全程没有停过。
    #
    # 读不到就退到 L0。绝不能退到 0：下面那次启动对齐会把 want_for(T) 写下去，
    # 读不到时退到 L0 —— 绝不能退到 0。
    # 注意 getL 自己拿 flock -x 9，所以必须在进入下面那段 flock 之前调用，
    # 否则自己等自己。
    local keep
    keep=$(getL)
    case "$keep" in
        "" | *[!0-9]*) keep=${L0:-25} ;;
    esac
    [ "$keep" -lt 25 ] && keep=${L0:-25}
    flock -x 9
    echo "$F._FSL 1 $keep" > "$DEV" 2>/dev/null; sleep 0.3
    echo "$EC.EC88 4 181 0x79 0x02 0" > "$DEV" 2>/dev/null
    flock -u 9
    sleep 0.3
}

want_for(){
    local t=$1
    [ "$t" -ge "$EMERG" ] && { echo "$E"; return; }
    [ "$t" -le "$IDLE" ] && { echo "$L0"; return; }
    [ "$t" -le "$T1" ]   && { echo "$L1"; return; }
    [ "$t" -le "$T2" ]   && { echo "$L2"; return; }
    [ "$t" -le "$T3" ]   && { echo "$L3"; return; }
    [ "$t" -le "$T4" ]   && { echo "$L4"; return; }
    [ "$t" -le "$T5" ]   && { echo "$L5"; return; }
    echo "$E"
}
# 该档的触发下界（升到它是因为超过了这个值）。
# 必须按【实际配置里的 L0..L5】推导，不能写成字面 case 表：原先这里硬编码了
# {25,30,40,50,60,70}（恰好等于 config/pfand.conf.example 的梯子），换一套梯子就整体
# 落进 `*)` 返回 $EMERG，降档门 `T <= EMERG-HYST` 恒真 —— 配置的滞回【完全失效】。
floor_of(){
    local lv=$1
    [ "$lv" = "$L0" ] && { echo -999; return; }
    [ "$lv" = "$L1" ] && { echo "$IDLE"; return; }
    [ "$lv" = "$L2" ] && { echo "$T1"; return; }
    [ "$lv" = "$L3" ] && { echo "$T2"; return; }
    [ "$lv" = "$L4" ] && { echo "$T3"; return; }
    [ "$lv" = "$L5" ] && { echo "$T4"; return; }
    echo "$EMERG"
}
# 该档所在带的中心温度（微调基准）。同样必须按实际 L0..L5 推导：
# 落进 `*)` 返回 $EMERG 时，w=(T-EMERG)*GAIN 恒为大负数，trim 被【永久钉在 -TRIM】，
# 配置里的 TRIM/GAIN 形同虚设（专家审计实测：performance 声明 68°C->62% 实际交付 54%，
# 比现役曲线的 60% 更弱，与它的名字相反）。
center_of(){
    local lv=$1
    [ "$lv" = "$L0" ] && { echo "$IDLE"; return; }
    [ "$lv" = "$L1" ] && { echo $(( (IDLE+T1)/2 )); return; }
    [ "$lv" = "$L2" ] && { echo $(( (T1+T2)/2 )); return; }
    [ "$lv" = "$L3" ] && { echo $(( (T2+T3)/2 )); return; }
    [ "$lv" = "$L4" ] && { echo $(( (T3+T4)/2 )); return; }
    [ "$lv" = "$L5" ] && { echo $(( (T4+T5)/2 )); return; }
    echo "$EMERG"
}

# ① 温度读取必须 fail-safe：读不到 → T=-1 → 立刻满速。
# 旧写法 `|| echo 0` 会 T=0 → want_for(0) 命中 <=IDLE → 风扇降到最低，
# 即传感器故障时风扇反而转得最慢（审计最严重的一项）。
readT(){
    local v
    v=$(cat "$Z" 2>/dev/null)
    case "$v" in
        "" | *[!0-9]*) T=-1 ;;
        *) T=$((v / 1000)); # 0 不可能是真实 CPU 温度，读到视为传感器故障 -> fail-safe
            [ "$T" -le 0 ] && T=-1 ;;
    esac
}
readT
log "[参数来源 $CONF] 骨架 ${L0}/${L1}/${L2}/${L3}/${L4}/${L5} 应急${EMERG}/${E} 微调±${TRIM}(${GAIN}/C) 上限${CAP} 死区${HYST}C 驻留${DWELL}s 输出死区${DEAD} 采样${IV}s"
ensure_s0i3

written=$(getL)
# 读不到 → -1，使 d=|L-(-1)| 必然 >= DEAD，保证一定会把档位写下去
[ -z "$written" ] && written=-1
base=25; trim=0; emerg=0; last=$(date +%s)

apply(){  # $1=目标值  $2=说明
    local L=$1
    [ "$L" -lt 25 ] && L=25
    [ "$L" -gt "$CAP" ] && L=$CAP
    local d=$(( L - written )); [ $d -lt 0 ] && d=$(( -d ))
    if [ "$d" -ge "$DEAD" ] || [ "$L" = "$E" ]; then
        setL "$L"; written=$L; last=$(date +%s)
        log "$2 set=$L T=${T}C base=$base trim=${trim}"
    fi
}

# 启动对齐：
#  - T<0（读温失败）或 T>=EMERG：直接 setL 满速并【跳过曲线对齐】。
#    绝不能让 apply() 代写：它把任何 >CAP 的目标钳到 CAP(70)，而 E=100 > CAP，
#    所以 apply 的 `|| [ "$L" = "$E" ]` 永远不成立 —— 冷启动已过热(≥80C)时
#    风扇会被压在 70% 停到第一个 IV 之后的应急分支才纠回 100%（I8，实测约 10s）。
#    T<0 同理：want_for(-1) 命中 <=IDLE 返回 L0=25，apply 会把刚写的 100 覆盖成 25。
#  - 其余走曲线对齐（微调基准 + apply 的启动写）。
if [ "$T" -lt 0 ]; then
    log "启动时温度读取失败 -> fail-safe 满速 ${E}%"
    base=$E; trim=0
    setL "$E"; written=$E
elif [ "$T" -ge "$EMERG" ]; then
    log "启动时 T=${T}C >= EMERG(${EMERG}C) -> 立即满速 ${E}%（绕过 apply 的 CAP 钳制）"
    base=$E; trim=0
    setL "$E"; written=$E
else
    tgt=$(want_for $T); base=$tgt
    c=$(center_of "$base"); w=$(( (T - c) * GAIN ))
    [ $w -gt $TRIM ] && w=$TRIM; [ $w -lt -$TRIM ] && w=$((-TRIM)); trim=$w
    apply "$(want_for $T)" "启动"
fi

# ⑬ 恢复应急锁定 —— 必须放在启动【对齐之后】：
# 对齐会按 want_for(T) 写一次，若在它之前恢复，这次对齐会把满速覆盖成本档（77C -> 70%），
# 要等下一个循环的"应急重推"才纠回来，中间是真实的低档窗口。
# 仅当温度仍高于 EMERG_REL 才算有效，否则视为滞回已过期。
if [ -r "$EMERG_FILE" ] && [ "$(cat "$EMERG_FILE" 2>/dev/null)" = "1" ]; then
    if [ "$T" -gt "$EMERG_REL" ]; then
        emerg=1; base=$E; trim=0
        setL "$E"; written=$E
        log "恢复应急锁定 T=${T}C > ${EMERG_REL}C（来自 $EMERG_FILE）"
    else
        echo 0 > "$EMERG_FILE" 2>/dev/null || log "清除应急状态失败: $EMERG_FILE"
        log "应急状态过期 T=${T}C <= ${EMERG_REL}C，已清除"
    fi
fi

while :; do
    sleep "$IV"
    now=$(date +%s)
    readT
    if [ "$T" -lt 0 ]; then
        setL "$E"; written=$E
        log "温度读取失败 -> fail-safe 满速 ${E}%"
        continue
    fi
    # ⑦ 对账：内部 written 只是自记，外部（面板/pfan/别的实例）改档或写失败时会失真。
    #    每轮读回真实 _FST 校正，DEAD 死区才建在真实值上。
    actual=$(getL)
    if [ -n "$actual" ] && [ "$actual" != "$written" ]; then
        log "对账: written=$written -> 实际=$actual (外部改档或写入未生效)"
        written=$actual
    fi
    tgt=$(want_for $T)

    # ---- 应急：进入易，退出难（锁定到 EMERG_REL） ----
    if [ "$tgt" = "$E" ] && [ "$emerg" = "0" ]; then
        emerg=1; trim=0; setL "$E"; written=$E; base=$E; last=$now
        echo 1 > "$EMERG_FILE" 2>/dev/null || log "写应急状态失败: $EMERG_FILE"
        log "应急满速 T=${T}C >= ${EMERG}C"; continue
    fi
    if [ "$emerg" = "1" ]; then
        # ③ 应急期间每次复核：风扇必须真的在 E 档（写失败/被抢都要重推）
        if [ "$written" != "$E" ]; then
            _prev="$written"
            setL "$E"; written=$E; last=$now
            log "应急重推: 实际=$_prev -> $E T=${T}C"
        fi
        [ "$T" -le "$EMERG_REL" ] || continue
        emerg=0; base=$(want_for "$T"); trim=0; last=$now
        echo 0 > "$EMERG_FILE" 2>/dev/null || log "写应急状态失败: $EMERG_FILE"
        log "应急解除 T=${T}C"; continue
    fi

    # ---- 骨架升档：立即（散热优先） ----
    if [ "$tgt" -gt "$base" ]; then
        base=$tgt; trim=0; apply "$base" "升温"; continue
    fi
    # ---- 骨架降档：需跌出死区 + 过驻留 ----
    if [ "$tgt" -lt "$base" ]; then
        f=$(floor_of "$base")
        if [ $((T - (f - HYST))) -le 0 ] && [ $((now - last)) -ge "$DWELL" ]; then
            base=$tgt; trim=0; apply "$base" "降温"; continue
        fi
    fi

    # ---- 细粒度微调：快升慢降（泄放），仅在骨架稳定时生效 ----
    c=$(center_of "$base")
    w=$(( (T - c) * GAIN ))
    [ $w -gt $TRIM ] && w=$TRIM
    [ $w -lt -$TRIM ] && w=$((-TRIM))
    if [ "$w" -ne "$trim" ]; then
        if [ "$w" -gt "$trim" ]; then
            trim=$w                                   # 升温立即跟随
        elif [ $((now - last)) -ge "$DWELL" ]; then
            if [ "$trim" -gt 0 ]; then trim=$(( trim-1 ))
            elif [ "$trim" -lt 0 ]; then trim=$(( trim+1 ))
            fi
        fi
    fi
    [ $((now - last)) -ge 8 ] && apply $(( base + trim )) "微调"
done
