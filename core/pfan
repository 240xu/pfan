#!/bin/bash
# pfan - 松下 CFQV8 风扇档位控制 (TFN1._FSL 写 / ._FST 读)
F="\_SB.PCI0.LPCB.EC0.TFN1"
DEV=/dev/pfanctl
[ -c "$DEV" ] || { echo "pfan: $DEV 非设备节点，先 insmod /opt/pfanctl/pfanctl.ko" >&2; exit 1; }
LOCK=/run/pfanel.lock
exec 8>"$LOCK"   # ⑥ 与 pfanel/pfand 共用单槽锁
# ⑤ 等新 RESULT 行，否则会读到上一次调用留下的旧值
run(){
  flock -x 8
  local before after
  before=$(sudo -n dmesg | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
  echo "$1 0" > $DEV
  local i=0
  while [ $i -lt 20 ]; do
    sleep 0.12; i=$((i+1))
    after=$(sudo -n dmesg | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
    [ -n "$after" ] && [ -n "$before" ] && \
      awk -v a="$after" -v b="$before" 'BEGIN{exit !(a>b)}' && break
  done
  sudo -n dmesg | grep "pfanctl: RESULT" | tail -1
  flock -u 8
}
case "$1" in
  get) run "$F._FST" | sed 's/.*RESULT //' ;;
  set) L=$2
       case "$L" in 0|25|30|40|50|60|70|80|85|90|95|100) ;; *) echo "档位: 0 25 30 40 50 60 70 80 85 90 95 100" >&2; exit 2;; esac
       echo "$F._FSL 1 $L" > $DEV; sleep 0.6
       echo "已设 ${L}% -> 当前 $(pfan get)" ;;
  sensors) run "\_SB_.PTID.OSDL" | sed 's/.*RESULT //' ;;
  list) echo "可选档位: 0(关) 25 30 40 50 60 70 80 85 90 95 100" ;;
  *) echo "用法: pfan {get|set <档位>|list|sensors}"; exit 1 ;;
esac
