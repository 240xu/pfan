#!/bin/bash
# pfan - 松下 CFQV8 风扇档位控制 (TFN1._FSL 写 / ._FST 读) + 平台探测
#
# 结构说明：设备节点与锁的获取【按命令】做，不再无条件前置。
#   detect 不碰 /dev/pfanctl（除非走真实 ACPI 探测），也不需要锁；
#   get/set/sensors 才需要 —— 而且锁失败必须中止，否则会读到陈旧 dmesg 值（backlog ②④）。
# 平台加载器（bash 侧）。找不到即中止 —— 不允许带未定义的路径继续。
_plat_sh="${PFAN_PLATFORM_SH:-/usr/local/lib/pfan/platform.sh}"
[ -f "$_plat_sh" ] || _plat_sh="$(dirname "$0")/platform.sh"
if ! . "$_plat_sh" 2>/dev/null || ! command -v pfan_plat >/dev/null 2>&1; then
  echo "pfan: 读不到平台加载器 $_plat_sh" >&2; exit 1
fi
# 路径一律来自 platform.conf（THERMAL_ZONE/EC_ROOT/FAN_DEVICE/DEV），
# 本文件不再出现具体 ACPI 路径 —— 唯一例外是候选清单，它在 platform/fan-candidates.txt。
PLAT_CAND="${PFAN_CANDIDATES:-$(dirname "$0")/../platform/fan-candidates.txt}"
[ -f "$PLAT_CAND" ] || PLAT_CAND="${PFAN_CANDIDATES:-/etc/pfan/fan-candidates.txt}"
# 面板目录的出厂值同样来自 example：detect 必须把它写进生成的 platform.conf。
# 不写的话，任何跑过 detect 的机器上 pfanel.py 的 _PLAT.get("PANEL_DIR", <代码兜底>)
# 都读不到该键、静默落回代码里的字面量，而 deploy.sh / smoke.sh 读的是这个 example
# —— 两个源，只是今天恰好相同（9eb0043 当时把它称作单一事实源；
#   2026-10-11 实测目标机 /etc/pfan/platform.conf 里 '^PANEL_DIR=' 为 0 行）。
# 接缝 PFAN_PLATFORM_EXAMPLE 供测试把 example 换成带哨兵值的一份；生产从不设置。
PLAT_EXAMPLE="${PFAN_PLATFORM_EXAMPLE:-$(dirname "$0")/../platform/platform.conf.example}"
# 已安装布局下没有 ../platform/ —— example 另装一份在 /usr/local/lib/pfan/（deploy.sh 3b2）。
# 少这一跳时 `pfan detect` 在任何部署机上 rc=9、什么都不写（2026-10-11 设备实测），
# 而 pfand 的恢复提示恰恰是「先跑 pfan detect」。形状同上方 PLAT_CAND 的兜底两跳。
[ -f "$PLAT_EXAMPLE" ] || PLAT_EXAMPLE="${PFAN_PLATFORM_EXAMPLE:-/usr/local/lib/pfan/platform.conf.example}"
# 测试接缝：真实控制路径需要 /dev/pfanctl 与 /run/pfanel.lock（都要 root），
# 单测用 PFAN_DEV=/dev/null + PFAN_LOCK=<临时文件> 覆盖。生产从不设置。
# 预设应用要写的权威文件与要重启的守护（与 pfand 的 PFAN_CONF 同一个接缝）
PFAN_CONF="${PFAN_CONF:-/etc/pfand.conf}"
PFAN_SERVICE="${PFAN_SERVICE:-pfand}"

DEV="${PFAN_DEV:-}" ; [ -n "$DEV" ] || DEV=$(pfan_plat DEV 2>/dev/null) || DEV=/dev/pfanctl
LOCK="${PFAN_LOCK:-/run/pfanel.lock}"
# dmesg 读取接缝（约定同 core/pfand：PFAN_DMESG，缺省 dmesg）。生产从不设置：
# 未设置时执行 `sudo -n dmesg` —— 与历史行为完全一致（pfan 直读 dmesg 可能被
# dmesg_restrict 拦）；设置后直接执行该命令 —— 测试/冒烟用它指向伪 dmesg，免 root。
# run()/acpi_ok() 里每一处 dmesg 读取都走 dmesg_out，不再各自硬编码 sudo -n dmesg。
DMESG="${PFAN_DMESG:-dmesg}"
dmesg_out(){
  if [ -n "${PFAN_DMESG:-}" ]; then "$DMESG"; else sudo -n "$DMESG"; fi
}
F=""
need_F(){   # 懒加载：detect 不需要 F（新机器上 platform.conf 还不存在）
  [ -n "$F" ] && return 0
  F=$(pfan_plat FAN_DEVICE 2>/dev/null) || F=""
  [ -n "$F" ] || { echo "pfan: platform.conf 缺 FAN_DEVICE —— 先跑: pfan detect --write /etc/pfan/platform.conf" >&2; return 1; }
}

need_dev(){
  # 显式设置 PFAN_DEV 时只查存在性（假设备是普通文件），否则必须是字符设备。
  if [ -n "${PFAN_DEV:-}" ]; then
    [ -e "$DEV" ] || { echo "pfan: PFAN_DEV=$DEV 不存在" >&2; return 1; }
  else
    [ -c "$DEV" ] || { echo "pfan: $DEV 非设备节点，先 insmod /opt/pfanctl/pfanctl.ko" >&2; return 1; }
  fi
}

# 拿锁 + 设备。任一失败即退出（不许降级继续读旧值）。
acquire(){
  need_dev || exit 1
  if ! exec 8>"$LOCK" 2>/dev/null; then
    echo "pfan: 打不开锁 $LOCK（多半是缺 root 权限）—— 中止，避免读到陈旧结果" >&2; exit 1
  fi
  flock -x 8 || { echo "pfan: flock 失败 —— 中止" >&2; exit 1; }
}

# ⑤ 等新 RESULT 行，否则会读到上一次调用留下的旧值
run(){
  local before after
  before=$(dmesg_out | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
  echo "$1 0" > "$DEV"
  local i=0
  while [ $i -lt 20 ]; do
    sleep 0.12; i=$((i+1))
    after=$(dmesg_out | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
    [ -n "$after" ] && [ -n "$before" ] && \
      awk -v a="$after" -v b="$before" 'BEGIN{exit !(a>b)}' && break
  done
  dmesg_out | grep "pfanctl: RESULT" | tail -1
  flock -u 8
}

# ACPI 路径是否真的可读：写一次 _FST 并等到新的 RESULT。
# 判不出结果一律返回 1（fail-closed）—— 探测宁可失败，也不能猜一个路径继续。
acpi_ok(){
  local before after i=0 got=0
  need_dev || return 1
  if ! exec 8>"$LOCK" 2>/dev/null; then return 1; fi
  flock -x 8 || return 1
  before=$(dmesg_out 2>/dev/null | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
  echo "$1 0" > "$DEV" 2>/dev/null || { flock -u 8; return 1; }
  while [ $i -lt 20 ]; do
    sleep 0.12; i=$((i+1))
    after=$(dmesg_out 2>/dev/null | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
    if [ -n "$after" ] && { [ -z "$before" ] || awk -v a="$after" -v b="$before" 'BEGIN{exit !(a>b)}'; }; then
      got=1; break
    fi
  done
  flock -u 8
  [ "$got" = 1 ]
}

detect(){
  local dir zone ec fan t
  dir="${PFAN_THERMAL_DIR:-/sys/class/thermal}"
  local -a zs=()
  for t in "$dir"/thermal_zone*/type; do
    [ -f "$t" ] || continue
    [ "$(cat "$t" 2>/dev/null)" = "x86_pkg_temp" ] && zs+=("${t%/type}")
  done
  case "${#zs[@]}" in
    1) zone="${zs[0]}/temp" ;;
    0) echo "pfan detect: $dir 下没有 x86_pkg_temp 热区 —— 拒绝猜测" >&2; return 3 ;;
    *) echo "pfan detect: 匹配到 ${#zs[@]} 个 x86_pkg_temp，索引不确定 —— 拒绝猜测:" >&2
       printf '  %s\n' "${zs[@]}" >&2; return 4 ;;
  esac

  # ACPI 候选成对读取（EC 根 与 风扇设备 可能不在同一子树）。
  [ -r "$PLAT_CAND" ] || { echo "pfan detect: 读不到候选清单 $PLAT_CAND" >&2; return 8; }
  local -a ec_c=() fan_c=()
  local _ec _fan
  while read -r _ec _fan; do
    [ -n "$_ec" ] && [ -n "$_fan" ] || continue
    ec_c+=("$_ec"); fan_c+=("$_fan")
  done < <(grep -vE '^#|^$' "$PLAT_CAND")
  [ ${#ec_c[@]} -gt 0 ] || { echo "pfan detect: 候选清单为空" >&2; return 8; }
  local i=0
  case "${PFAN_ACPI_PROBE:-}" in
    fail) echo "pfan detect: ACPI 候选全部读不到 _FST —— 拒绝回退默认值" >&2; return 5 ;;
    ok:*) ec="${PFAN_ACPI_PROBE#ok:}"; fan="$ec.TFN1" ;;
    *)
      while [ $i -lt ${#ec_c[@]} ]; do
        if acpi_ok "${fan_c[$i]}._FST"; then ec="${ec_c[$i]}"; fan="${fan_c[$i]}"; break; fi
        i=$((i+1))
      done
      if [ -z "${ec:-}" ]; then
        echo "pfan detect: 三组 ACPI 候选都读不到 _FST —— 拒绝猜默认值" >&2; return 5
      fi ;;
  esac

  local out
  printf -v out '%s\n' \
    "EC_ROOT=$ec" "FAN_DEVICE=$fan" "THERMAL_ZONE=$zone" \
    "DEV=$DEV" "EC_CMD=0xB5"
  # 面板目录也写出来（理由见文件头 PLAT_EXAMPLE）。值取自仓库 example，不抄字面量 ——
  # 抄一份就等于又立一个事实源，正是这一段要消除的东西。
  local panel
  panel=$(sed -n 's/^PANEL_DIR=//p' "$PLAT_EXAMPLE" 2>/dev/null | head -1)
  # 空值不写：pfanel.py 的 get() 只看 key 在不在，空字符串会被当成有效路径
  # （PANEL_DIR="" -> VENDOR_DIR="vendor" -> 面板从进程 cwd 读）。宁可 detect 失败。
  [ -n "$panel" ] || { echo "pfan detect: $PLAT_EXAMPLE 没声明 PANEL_DIR —— 拒绝写出空值（pfanel 会把空串当路径，面板从 cwd 读）" >&2; return 9; }
  printf -v out '%s\n' "$out" "PANEL_DIR=$panel"
  if [ "${1:-}" = "--write" ]; then
    [ -n "${2:-}" ] || { echo "pfan detect: --write 需要目标路径" >&2; return 6; }
    # 原子写：直接 printf > "$2" 中途崩溃会留下半截配置，下次开机 fail-close。
    # 同目录 temp + rename（同一文件系统内 rename 是原子的），失败即清理。
    printf '%s' "$out" > "$2.tmp.$$" || { rm -f "$2.tmp.$$"; echo "pfan detect: 写 $2.tmp 失败" >&2; return 7; }
    mv -f "$2.tmp.$$" "$2" || { rm -f "$2.tmp.$$"; echo "pfan detect: 提交 $2 失败" >&2; return 7; }
    echo "pfan detect: 已写入 $2"
  else
    printf '%s' "$out"
  fi
}

# ---- 预设（config/pfand.conf.<名字>）--------------------------------------------
# 存在理由：这两套预设原先【没有任何消费者】——面板、pfanel、deploy、smoke、文档
# 都不引用它们，想用只能手工 cp 覆盖 /etc/pfand.conf，而 OPERATIONS.md 恰恰写着
# 「不要只在机器上手改，否则下次 smoke 必红」。也就是说：交付了一个用不了的配置。
#
# 这里给出受校验的入口，并遵守既有纪律：
#   * 走与面板 /api/params 相同的 validate_params（server/pfan_core.py）
#   * 原子替换（.tmp + os.replace 等价的 mv），pfand 不会读到半截文件
#   * 应用后提示 smoke 会因 sha 变化而红，并给出同步命令 —— 不假装可以绕过
preset_dir(){ printf '%s' "${PFAN_PRESET_DIR:-/opt/pfanctl/presets}"; }
preset_names(){
  d=$(preset_dir); [ -d "$d" ] || { echo "预设目录不存在: $d" >&2; return 1; }
  # 不用 ls 通配符：部分 sh（Termux 的 sh、以及脚本被 . 引用时的解析环境）不展开
  # pfan.conf.*，于是 list 会静默返回空。
  # 用 ls -1 + 参数展开，而不是 find -name / ls 通配符：
  # 实测本机 find 的 -name 完全不生效（连精确文件名都匹配不到），而脚本被 `.`
  # 引用时 glob 也不展开。ls -1 列目录是这三者里唯一到处都能用的。
  ls -1 "$d" 2>/dev/null | while read -r f; do
    case "$f" in
      pfan.conf.*) printf '%s\n' "${f#pfan.conf.}" ;;
    esac
  done | grep -v '^\*' | sort
}
preset_show(){
  n=${1:-}; d=$(preset_dir); f="$d/pfan.conf.$n"
  [ -n "$n" ] || { echo "用法: pfan preset show <名字>" >&2; preset_names; return 1; }
  [ -f "$f" ] || { echo "没有预设 '$n'。可用：" >&2; preset_names >&2; return 1; }
  cat "$f"
}
preset_validate(){ # preset_validate <文件>
  python3 - "$1" <<'PVEOF'
import os, re, sys
# pfan_core.py 装在 /usr/local/bin（deploy 的安装目标）；仓库内测试时它在 server/。
# ⚠ 不能用相对路径 "server"：调用方 cwd 不是仓库根（pfan 从 /usr/local/bin 跑，或从
# 任意目录跑），相对路径会找不到 —— 而 import 失败抛出的异常会被调用方的
# `|| return 1` 吞成「校验没通过」，看起来像校验在生效，其实是它根本没跑起来。
# 我第一版正是这样：坏曲线（EMERG 改成 40，明显自相矛盾）通过了 apply。
_cands = ["/usr/local/bin", "/opt/pfanctl", os.path.join(os.getcwd(), "server")]
for _p in _cands:
    if os.path.isfile(os.path.join(_p, "pfan_core.py")):
        sys.path.insert(0, _p); break
else:
    print("找不到 pfan_core.py（试过 %s）—— 校验没有真的跑" % ", ".join(_cands), file=sys.stderr)
    sys.exit(2)
from pfan_core import validate_params
d = {}
try:
    for line in open(sys.argv[1], encoding="utf-8"):
        m = re.match(r"^([A-Z0-9_]+)=(-?\d+)\s*$", line.strip())
        if m:
            d[m.group(1)] = int(m.group(2))
except OSError as ex:
    print("读不到 %s: %s" % (sys.argv[1], ex), file=sys.stderr)
    sys.exit(2)
errs = validate_params(d)
for e in errs:
    print("  参数错误: %s" % e, file=sys.stderr)
sys.exit(1 if errs else 0)
PVEOF
}
preset_apply(){
  n=${1:-}; d=$(preset_dir); f="$d/pfan.conf.$n"
  [ -n "$n" ] || { echo "用法: pfan preset apply <名字>" >&2; preset_names >&2; return 1; }
  [ -f "$f" ] || { echo "没有预设 '$n'。可用：" >&2; preset_names >&2; return 1; }
  preset_validate "$f" || { echo "  预设 '$n' 未通过 validate_params —— 拒绝应用（一个坏曲线比旧曲线危险）" >&2; return 1; }
  [ "$(id -u)" = 0 ] || { echo "需要 root：改 /etc/pfand.conf" >&2; return 1; }
  T=$(mktemp "${TMPDIR:-/tmp}/pfand.conf.XXXXXX") || return 1
  cp "$f" "$T" || { rm -f "$T"; return 1; }
  chmod 644 "$T"
  mv "$T" "$PFAN_CONF" || { rm -f "$T"; echo "写入 $PFAN_CONF 失败" >&2; return 1; }
  echo "已应用预设 '$n' 到 $PFAN_CONF"
  echo "⚠ 两件必须做的事，否则下次 smoke 必红："
  echo "  1) 同步仓库副本：  cp $f config/pfand.conf.example   （然后提交）"
  echo "  2) 让守护重读：    systemctl restart $PFAN_SERVICE"
  echo "  校验：             bash scripts/smoke.sh"
}
preset_cmd(){
  sub=${1:-list}; shift 2>/dev/null || true
  case "$sub" in
    list)   preset_names ;;
    show)   preset_show "$@" ;;
    apply)  preset_apply "$@" ;;
    *)      echo "用法: pfan preset {list|show <名字>|apply <名字>}" >&2; exit 1 ;;
  esac
}

case "$1" in
  detect) shift; detect "$@" ;;
  get)    need_F || exit 1; acquire; run "$F._FST" | sed 's/.*RESULT //' ;;
  set)    L=${2:-}
          # 细粒度：固件支持 0~120 任意整数（fine_grain_control=1）。
          # 但 0 被明确禁止 —— 实测 _FSL 0 = 风扇停转（不是"交回曲线"）。
          case "$L" in
            ''|*[!0-9]*) echo "档位必须是 1..120 的整数" >&2; exit 2 ;;
          esac
          # 前导零必须拒（belt-and-braces，M9）：pfanctl 的 pfan_parse 现在按【十进制】
          # 解析，"080" 得到 80 —— 内核按八进制把它截成 0 的那条老路已经不存在。
          # 仍然要拒的理由：0 本身是禁的（_FSL 0 = 风扇停转），而 "080"/"050" 这类写法
          # 十进制读是 80/50、老的八进制直觉读是 0/40 —— 静默取哪个都不是用户的本意，
          # 宁可报错；顺带也挡住 pfanctl 日后退回 base-0 解析的回归。
          case "$L" in
            0*) echo "档位必须在 1..120（0 被禁：实测 _FSL 0 = 风扇停转；前导零直接拒——十进制下 080 是 80，老八进制下是 0，静默接受哪个都不对）" >&2; exit 2 ;;
          esac
          [ "$L" -ge 1 ] && [ "$L" -le 120 ] || {
            echo "档位必须在 1..120（0 被禁：实测 _FSL 0 = 风扇停转）" >&2; exit 2; }
          need_F || exit 1
          acquire
          echo "$F._FSL 1 $L" > "$DEV"; sleep 0.6
          # 读回必须在【进程内】用 run，绝不能 $(pfan get)：
          # 子进程会 exec 8> 重开锁文件得到新的 open file description，然后 flock -x 8
          # 与持锁的父进程互等 -> 永久死锁，连带锁住 pfand 与 pfanel（复审 C1，2026-10-06 实测）。
          rb=$(run "$F._FST" | sed 's/.*RESULT //')
          flock -u 8 2>/dev/null || true
          echo "已设 ${L}% -> 当前 ${rb:-<读回失败>}" ;;
  preset) shift; preset_cmd "$@" ;;
  sensors) need_F || exit 1; acquire; run "\_SB.PTID.OSDL" | sed 's/.*RESULT //' ;;
  list)   echo "档位: 1..120 任意整数（0 被禁：实测 _FSL 0 = 风扇停转）" ;;
  *)      echo "用法: pfan {detect [--write <file>]|get|set <档位>|preset <list|show|apply> <名字>|list|sensors}"; exit 1 ;;
esac
