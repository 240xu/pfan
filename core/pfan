#!/bin/bash
# pfan - 松下 CFQV8 风扇档位控制 (TFN1._FSL 写 / ._FST 读) + 平台探测
#
# 结构说明：设备节点与锁的获取【按命令】做，不再无条件前置。
#   detect 不碰 /dev/pfanctl（除非走真实 ACPI 探测），也不需要锁；
#   get/set/sensors 才需要 —— 而且锁失败必须中止，否则会读到陈旧 dmesg 值（backlog ②④）。
F="\_SB.PCI0.LPCB.EC0.TFN1"
DEV=/dev/pfanctl
LOCK=/run/pfanel.lock

need_dev(){ [ -c "$DEV" ] || { echo "pfan: $DEV 非设备节点，先 insmod /opt/pfanctl/pfanctl.ko" >&2; return 1; }; }

# 拿锁 + 设备。任一失败即退出（不许降级继续读旧值）。
acquire(){
  need_dev || exit 1
  if ! exec 8>"$LOCK" 2>/dev/null; then
    echo "pfan: 打不开锁 $LOCK（多半是缺 root 权限）—— 中止，避免读到陈旧结果" >&2; exit 1
  fi
  flock -x 8 || { echo "pfan: flock 失败 —— 中止" >&2; exit 1; }
}

# ⑤ 等新 RESULT 行，否则会读到上一次调用留下的旧值
run(){
  local before after
  before=$(sudo -n dmesg | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
  echo "$1 0" > "$DEV"
  local i=0
  while [ $i -lt 20 ]; do
    sleep 0.12; i=$((i+1))
    after=$(sudo -n dmesg | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
    [ -n "$after" ] && [ -n "$before" ] && \
      awk -v a="$after" -v b="$before" 'BEGIN{exit !(a>b)}' && break
  done
  sudo -n dmesg | grep "pfanctl: RESULT" | tail -1
  flock -u 8
}

# ACPI 路径是否真的可读：写一次 _FST 并等到新的 RESULT。
# 判不出结果一律返回 1（fail-closed）—— 探测宁可失败，也不能猜一个路径继续。
acpi_ok(){
  local before after i=0 got=0
  need_dev || return 1
  if ! exec 8>"$LOCK" 2>/dev/null; then return 1; fi
  flock -x 8 || return 1
  before=$(sudo -n dmesg 2>/dev/null | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
  echo "$1 0" > "$DEV" 2>/dev/null || { flock -u 8; return 1; }
  while [ $i -lt 20 ]; do
    sleep 0.12; i=$((i+1))
    after=$(sudo -n dmesg 2>/dev/null | grep "pfanctl: RESULT" | tail -1 | awk -F'[][]' '{print $2}')
    if [ -n "$after" ] && { [ -z "$before" ] || awk -v a="$after" -v b="$before" 'BEGIN{exit !(a>b)}'; }; then
      got=1; break
    fi
  done
  flock -u 8
  [ "$got" = 1 ]
}

detect(){
  local dir zone ec fan t
  dir="${PFAN_THERMAL_DIR:-/sys/class/thermal}"
  local -a zs=()
  for t in "$dir"/thermal_zone*/type; do
    [ -f "$t" ] || continue
    [ "$(cat "$t" 2>/dev/null)" = "x86_pkg_temp" ] && zs+=("${t%/type}")
  done
  case "${#zs[@]}" in
    1) zone="${zs[0]}/temp" ;;
    0) echo "pfan detect: $dir 下没有 x86_pkg_temp 热区 —— 拒绝猜测" >&2; return 3 ;;
    *) echo "pfan detect: 匹配到 ${#zs[@]} 个 x86_pkg_temp，索引不确定 —— 拒绝猜测:" >&2
       printf '  %s\n' "${zs[@]}" >&2; return 4 ;;
  esac

  # ACPI 候选是【成对】的：EC 根 与 风扇设备 可能不在同一子树
  # （社区机型存在风扇位于 \_SB.IETM.TFN1 的情况）。
  local -a ec_c=( '\_SB.PCI0.LPCB.EC0' '\_SB.PC00.LPCB.EC0' '\_SB.PC00.LPCB.EC0' )
  local -a fan_c=( '\_SB.PCI0.LPCB.EC0.TFN1' '\_SB.PC00.LPCB.EC0.TFN1' '\_SB.IETM.TFN1' )
  local i=0
  case "${PFAN_ACPI_PROBE:-}" in
    fail) echo "pfan detect: ACPI 候选全部读不到 _FST —— 拒绝回退默认值" >&2; return 5 ;;
    ok:*) ec="${PFAN_ACPI_PROBE#ok:}"; fan="$ec.TFN1" ;;
    *)
      while [ $i -lt ${#ec_c[@]} ]; do
        if acpi_ok "${fan_c[$i]}._FST"; then ec="${ec_c[$i]}"; fan="${fan_c[$i]}"; break; fi
        i=$((i+1))
      done
      if [ -z "${ec:-}" ]; then
        echo "pfan detect: 三组 ACPI 候选都读不到 _FST —— 拒绝猜默认值" >&2; return 5
      fi ;;
  esac

  local out
  printf -v out '%s\n' \
    "EC_ROOT=$ec" "FAN_DEVICE=$fan" "THERMAL_ZONE=$zone" \
    "DEV=$DEV" "EC_CMD=0xB5"
  if [ "${1:-}" = "--write" ]; then
    [ -n "${2:-}" ] || { echo "pfan detect: --write 需要目标路径" >&2; return 6; }
    printf '%s' "$out" > "$2" || { echo "pfan detect: 写 $2 失败" >&2; return 7; }
    echo "pfan detect: 已写入 $2"
  else
    printf '%s' "$out"
  fi
}

case "$1" in
  detect) shift; detect "$@" ;;
  get)    acquire; run "$F._FST" | sed 's/.*RESULT //' ;;
  set)    L=$2
          case "$L" in 0|25|30|40|50|60|70|80|85|90|95|100) ;; *) echo "档位: 0 25 30 40 50 60 70 80 85 90 95 100" >&2; exit 2;; esac
          acquire
          echo "$F._FSL 1 $L" > $DEV; sleep 0.6
          echo "已设 ${L}% -> 当前 $(pfan get)" ;;
  sensors) acquire; run "\_SB_.PTID.OSDL" | sed 's/.*RESULT //' ;;
  list)   echo "可选档位: 0(关) 25 30 40 50 60 70 80 85 90 95 100" ;;
  *)      echo "用法: pfan {detect [--write <file>]|get|set <档位>|list|sensors}"; exit 1 ;;
esac
